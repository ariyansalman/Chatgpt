# Copy this file to .env for local development, OR — for Railway — paste
# each of these as environment variables in the Railway dashboard
# (Project → Service → Variables). Never commit a real .env file.

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_ID=your_user_id_here
ADMIN_TELEGRAM_USERNAME=your_username_here

# Database Configuration
# Local dev (default, no setup needed):
#   DATABASE_URL=sqlite:///bot_database.db
# Production on Railway, using Supabase Postgres — copy the "Session pooler"
# or direct connection string from Supabase → Project Settings → Database,
# and make sure it starts with postgresql:// (not postgres://):
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[email protected]:5432/postgres

# Crypto Payment Configuration
CRYPTO_BOT_API_KEY=your_api_key_here

# Telegram Payments (Card) Configuration
TELEGRAM_PROVIDER_TOKEN=your_api_key_here

# Currency the card invoice is charged in (must be USD-denominated to match wallet amounts).
PAYMENT_CURRENCY=USD

# Binance Pay Configuration
# API key/secret from a REGULAR (non-merchant) Binance account — Account ->
# API Management -> Create API. Default read permissions are enough, do NOT
# enable trading/withdrawal.
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
# Your Binance ID / Pay ID, shown to buyers as the "send to" target.
BINANCE_PAY_ID=your_binance_id
# Optional fallback on-chain deposit address.
BINANCE_DEPOSIT_ADDRESS=
BINANCE_DEPOSIT_COIN=USDT

# Bybit Pay Configuration
# API key/secret from a REGULAR (non-merchant) Bybit account — Account ->
# API -> Create New Key. Read-only (Wallet: read) is enough.
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
# Your Bybit UID or email, shown to buyers as the "send to" target for a
# free internal (off-chain) transfer.
BYBIT_UID=your_bybit_uid
# Optional fallback on-chain deposit address.
BYBIT_DEPOSIT_ADDRESS=
BYBIT_DEPOSIT_COIN=USDT
BYBIT_DEPOSIT_CHAIN=TRX

# ZiniPay (bKash / Nagad / Rocket) Configuration
# API key from ZiniPay dashboard -> Brands -> Brand Key / API Key.
ZINIPAY_API_KEY=your_zinipay_api_key
# Public HTTPS base URL where this webhook_server.py is deployed (same
# domain as your CryptoBot webhook, e.g. https://yourapp.up.railway.app).
PUBLIC_BASE_URL=https://your-domain.com
# Only set these if PUBLIC_BASE_URL's domain is NOT the website domain
# registered against your ZiniPay brand — otherwise leave blank, they'll
# default to PUBLIC_BASE_URL + /zinipay/success and /zinipay/cancel.
ZINIPAY_REDIRECT_URL=
ZINIPAY_CANCEL_URL=

# Only used locally by webhook_server.py's dev server (Railway sets PORT
# automatically for the "web" process — do not set this in Railway).
# PORT=5000
