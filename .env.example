# =====================================================================
# TELEGRAM BOT — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.
# =====================================================================

# ── Required ─────────────────────────────────────────────────────────

# Your bot token from @BotFather
BOT_TOKEN=

# Your personal Telegram user ID (numeric). Get it from @userinfobot
ADMIN_TELEGRAM_ID=

# Your Telegram username (without @), shown in some admin screens
ADMIN_TELEGRAM_USERNAME=

# PostgreSQL connection string (Supabase, Railway, Neon, etc.)
# Format: postgresql://user:password@host:port/dbname
# Local fallback: leave empty → uses SQLite (bot_database.db)
DATABASE_URL=

# ── Admin 2FA (optional) ─────────────────────────────────────────────
# Set to "true" to require OTP verification for every admin session.
# Default is "false" (admin can use all features without OTP).
ADMIN_2FA_ENABLED=false

# ── Run Mode ─────────────────────────────────────────────────────────
# "polling"  — default, works everywhere, no public URL needed.
# "webhook"  — requires a public HTTPS URL (e.g. Render, VPS).
RUN_MODE=polling

# Webhook settings (only needed when RUN_MODE=webhook)
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/telegram
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_SECRET=

# ── Binance Pay (env-only — NEVER enter these in the admin panel) ────
# Read-only Binance API credentials for verifying payments.
# Go to Binance → API Management → create Read-Only key.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Bybit Pay (env-only — NEVER enter these in the admin panel) ──────
# Read-only Bybit V5 API credentials for verifying deposits.
# Go to Bybit → API Management → create Read-Only key.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── ZiniPay ──────────────────────────────────────────────────────────
# API key from https://zinipay.com
# Wallet numbers (bKash/Nagad/Rocket/Upay) are set in the admin panel.
ZINIPAY_API_KEY=

# ── Telegram Payments (Card) ─────────────────────────────────────────
# Provider token from @BotFather → Payments → connect a provider.
TELEGRAM_PROVIDER_TOKEN=
PAYMENT_CURRENCY=USD

# ── bKash (fallback only — admin panel values take priority) ─────────
# These are only used before the admin configures bKash in the panel.
BKASH_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── Nagad (fallback only — admin panel values take priority) ─────────
NAGAD_MODE=sandbox
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# PEM-encoded keys (base64 body or full PEM block)
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# ── Cryptomus (fallback only — admin panel values take priority) ─────
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_API_KEY=

# ── Heleket (fallback only — admin panel values take priority) ────────
HELEKET_MERCHANT_ID=
HELEKET_PAYMENT_API_KEY=

# ── NOWPayments (fallback only — admin panel values take priority) ────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── CryptoBot (@CryptoBot) ───────────────────────────────────────────
CRYPTO_BOT_API_KEY=

# ── Sentry (optional error tracking) ────────────────────────────────
# Get DSN from https://sentry.io
SENTRY_DSN=
